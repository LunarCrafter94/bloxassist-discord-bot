# Copy this file to private-configs/credentials.env.
# Never commit your real credentials.env or share it publicly.

# Discord application token
DISCORD_TOKEN=

# Optional: sync slash commands to one test server. Leave blank for global sync.
GUILD_ID=

# Database backend: sqlite (default) or postgresql.
DATABASE_BACKEND=sqlite

# Required only for PostgreSQL hosting (for example, a Supabase session-pooler URL).
# This URL contains a database password: keep it only in credentials.env / hosting secrets.
DATABASE_URL=

# Optional automated hourly per-server encrypted ZIP backups sent to your Discord DM.
# Use your numeric Discord user ID, not a username.
BACKUP_DISCORD_USER_ID=

# Strong random password for AES-256-encrypted ZIP backups. Store it somewhere separate.
BACKUP_ENCRYPTION_PASSWORD=
